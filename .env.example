# =============================================================
# FraudShield — Environment Variables Template
# =============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# =============================================================

# --- Application -----------------------------------------------
APP_NAME=FraudShield
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true
SECRET_KEY=

# --- Backend API -----------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000/api/v1

# --- Database --------------------------------------------------
# PostgreSQL connection string
# NOTE: This is an example! Do not use these exact credentials in production.
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://fraudshield_user:password@localhost:5432/fraudshield_db

# --- Frontend --------------------------------------------------
# The public URL the Next.js app uses to call the backend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# --- Security --------------------------------------------------
# Algorithm used for JWT signing (future use)
JWT_ALGORITHM=HS256
# Token expiry in minutes (future use)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS ------------------------------------------------------
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# --- ML / NLP --------------------------------------------------
# Path to trained model artifact
ML_MODEL_PATH=ml/models/fraud_model.pkl
ML_MODEL_VERSION=ml-v1

# --- Voice / NLP API (future use) ------------------------------
VOICE_NLP_API_KEY=
VOICE_NLP_API_URL=

# --- Privacy ---------------------------------------------------
# NEVER store raw transcripts in production for privacy reasons.
STORE_RAW_TRANSCRIPT=false

# --- Logging ---------------------------------------------------
LOG_LEVEL=INFO
