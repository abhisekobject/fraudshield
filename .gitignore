# =============================================================
# FraudShield — .gitignore
# =============================================================

# ----- Environment & Secrets --------------------------------
.env
.env.local
.env.*.local
*.env

# ----- Python -----------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/
pip-wheel-metadata/
*.pyc

# ----- pytest / coverage ------------------------------------
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.dmypy.json

# ----- Node / npm -------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm

# ----- Next.js ----------------------------------------------
frontend/.next/
frontend/out/
frontend/.turbo/

# ----- ML artifacts -----------------------------------------
ml/models/*.pkl
ml/models/*.joblib
ml/models/*.h5
ml/models/*.pt
ml/models/*.onnx
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/synthetic/.gitkeep

# ----- Docker -----------------------------------------------
docker/*.log

# ----- OS ---------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*~

# ----- IDE --------------------------------------------------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ----- Alembic ----------------------------------------------
backend/alembic/versions/*.pyc

# ----- Logs -------------------------------------------------
*.log
logs/
